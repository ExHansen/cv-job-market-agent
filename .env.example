# ============================================================
# LLM Provider Configuration (Local Ollama vs Live Demo Cloud)
# ============================================================
# Options: "ollama" (100% local & private) | "openai_compatible" (Groq/OpenRouter/Gemini for hosted demo)
LLM_PROVIDER=ollama

# Local Ollama settings (tuned for RTX 4060 8GB VRAM + 32GB DDR5 RAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=8192

# Optional OpenAI-compatible API settings (used only when LLM_PROVIDER=openai_compatible)
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# ============================================================
# Storage & Data Paths
# ============================================================
DATA_DIR=../data
CONFIG_DIR=../config
DUCKDB_PATH=../data/market.duckdb
LANCEDB_PATH=../data/vectors.lancedb
MARKET_CACHE_TTL_DAYS=7

# ============================================================
# Backend & Frontend URLs
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# Phase 2: Arize Phoenix OpenTelemetry Tracing
# ============================================================
ENABLE_PHOENIX_TRACING=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006
